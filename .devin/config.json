{
  "permissions": {
    "allow": [
      "Read(**)",
      "Exec(uv)",
      "Exec(uv sync)",
      "Exec(uv run)",
      "Exec(uv run ruff)",
      "Exec(uv run ruff check)",
      "Exec(uv run ruff format)",
      "Exec(uv run python manage.py)",
      "Exec(python -V)",
      "Exec(uv run pytest)",
      "Exec(docker compose)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git branch)",
      "Exec(git add)",
      "Exec(git commit)",
      "Exec(git show)",
      "Exec(git stash)",
      "Exec(git checkout)",
      "Exec(git merge)"
    ],
    "ask": [
      "Exec(git push)",
      "Exec(git rebase)",
      "Exec(git reset --hard)",
      "Exec(git clean -fd)",
      "Exec(git tag)",
      "Exec(docker build)",
      "Write(pyproject.toml)",
      "Write(uv.lock)",
      "Write(settings/*.py)"
    ],
    "deny": [
      "Exec(sudo)",
      "Exec(rm -rf /)",
      "Exec(mkfs)",
      "Exec(shutdown)",
      "Exec(halt)",
      "Write(.env)"
    ]
  }
}
