{
  "permissions": {
    "allow": [
      "Read(**)",
      "Exec(./gradlew)",
      "Exec(./gradlew assembleDebug)",
      "Exec(./gradlew testDebugUnitTest)",
      "Exec(./gradlew lint)",
      "Exec(./gradlew tasks)",
      "Exec(./gradlew --version)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git branch)",
      "Exec(git add)",
      "Exec(git commit)",
      "Exec(git show)",
      "Exec(git stash)",
      "Exec(git checkout)",
      "Exec(git merge)",
      "Exec(gh run list)",
      "Exec(gh run view)",
      "Exec(gh run watch)"
    ],
    "ask": [
      "Exec(git push)",
      "Exec(git rebase)",
      "Exec(git reset --hard)",
      "Exec(git clean -fd)",
      "Exec(git tag)",
      "Exec(gh pr create)",
      "Exec(gh release create)",
      "Write(app/build.gradle)",
      "Write(global.gradle)",
      "Write(settings.gradle)",
      "Write(.github/workflows/*.yml)"
    ],
    "deny": [
      "Exec(sudo)",
      "Exec(rm -rf /)",
      "Exec(mkfs)",
      "Exec(shutdown)",
      "Exec(halt)",
      "Write(.env)",
      "Write(local.properties)",
      "Write(keystore-info.txt)",
      "Write(**/*.jks)"
    ]
  }
}
